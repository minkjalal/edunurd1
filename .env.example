# EduNerd Environment Configuration
PORT=3000
JWT_SECRET=edunerd-secret-key-change-this-in-production-2026

# Optional: Google Gemini API (Recommended for AI Tutor & Question Generation)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Anthropic Claude API alternative
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: Google OAuth Sign-in Client ID
# Set up at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
